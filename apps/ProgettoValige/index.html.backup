<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Knowledge Vault</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f8fafc; --surface: #ffffff; --surface-hover: #f1f5f9;
            --primary: #2563eb; --primary-hover: #1d4ed8;
            --text-main: #0f172a; --text-muted: #64748b; --border: #e2e8f0;
            --status-bg: #dcfce7; --status-text: #166534;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --radius-lg: 16px; --radius-md: 10px; --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg); color: var(--text-main); padding: 2rem; line-height: 1.6; }
        .container { max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; }
        
        /* HEADER & NAV */
        header { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 1rem; }
        .title-area h1 { font-size: 2.25rem; font-weight: 700; letter-spacing: -0.03em; color: #0f172a;}
        .title-area p { color: var(--text-muted); font-size: 1rem; margin-top: 0.25rem; font-weight: 400;}
        
        .main-nav { display: flex; gap: 0.75rem; background: var(--surface); padding: 0.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-sm); margin-bottom: 1rem;}
        .nav-tab { flex: 1; padding: 0.75rem 1.5rem; border: none; background: transparent; font-size: 0.95rem; font-weight: 600; color: var(--text-muted); border-radius: var(--radius-md); cursor: pointer; transition: var(--transition); text-align: center; }
        .nav-tab.active { background: var(--bg); color: var(--primary); box-shadow: var(--shadow-sm); border: 1px solid var(--border); }
        .nav-tab:hover:not(.active) { background: var(--surface-hover); color: var(--text-main); }

        .controls-area { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;}
        .icon-btn { background: var(--surface); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: var(--radius-md); cursor: pointer; font-weight: 500; color: var(--text-main); box-shadow: var(--shadow-sm); transition: var(--transition); display: inline-flex; align-items: center; justify-content: center;}
        .icon-btn:hover { background: var(--surface-hover); border-color: var(--primary); color: var(--primary);}
        .icon-btn.danger:hover { border-color: #ef4444; color: #ef4444; background: #fef2f2; }
        
        .btn-primary { background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; cursor: pointer; transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: var(--shadow-sm);}
        .btn-primary:hover:not(:disabled) { background: var(--primary-hover); transform: translateY(-1px); box-shadow: var(--shadow-md); }
        .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; box-shadow: none; }
        
        .btn-secondary { background: var(--surface); color: var(--text-main); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: var(--radius-md); font-weight: 500; cursor: pointer; transition: var(--transition); display: inline-flex; align-items: center; gap: 0.5rem;}
        .btn-secondary:hover { border-color: var(--text-muted); background: var(--surface-hover); }

        .view-controls { display: flex; gap: 0.25rem; background: var(--bg); padding: 0.25rem; border-radius: var(--radius-md); border: 1px solid var(--border); }
        .view-btn { background: transparent; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; font-weight: 600; color: var(--text-muted); transition: var(--transition); font-size: 0.85rem;}
        .view-btn.active { background: var(--surface); color: var(--text-main); box-shadow: var(--shadow-sm); }
        
        /* SPINNER ANIMATION */
        .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-radius: 50%; border-top-color: #fff; animation: spin 0.8s linear infinite; }
        .btn-secondary .spinner { border-color: rgba(0,0,0,0.1); border-top-color: var(--text-main); }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* LAYOUT & SIDEBAR */
        .layout { display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start; }
        .sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 2rem; z-index: 10; max-height: calc(100vh - 4rem); overflow-y: auto; padding-right: 0.5rem;}
        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        .panel { background: var(--surface); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .panel h2 { font-size: 1.125rem; margin-bottom: 1.25rem; font-weight: 700; color: var(--text-main);}
        
        .filter-group { margin-bottom: 1.5rem; }
        .filter-group h3 { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;}
        .checkbox-list { display: flex; flex-direction: column; gap: 0.6rem; max-height: 250px; overflow-y: auto; }
        .checkbox-label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; cursor: pointer; color: var(--text-main); font-weight: 500;}
        
        .view-section { display: none; animation: fadeIn 0.3s ease; }
        .view-section.active { display: block; }
        .sidebar-section { display: none; animation: fadeIn 0.3s ease; }
        .sidebar-section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        /* TAGS */
        .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.75rem; }
        .tag { font-size: 0.75rem; padding: 0.25rem 0.65rem; border-radius: 6px; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; box-sizing: border-box; }
        
        .tag-field { color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.15); border: 1px solid rgba(0,0,0,0.1); }
        .tag-section { color: var(--text-main); } 
        .tag-status { background-color: var(--status-bg); color: var(--status-text); border: 1px solid #bbf7d0;}
        .tag-source-link { background: var(--bg); color: var(--text-main); border: 1px solid var(--border); }
        .tag-primary-star { color: #f59e0b; margin-right: 4px; font-size: 0.85rem;}

        /* GRIDS & CARDS */
        .topics-container { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
        .topic-card { background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-sm); transition: var(--transition); display: flex; flex-direction: column; cursor: pointer; }
        .topic-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #93c5fd; }
        .topic-image { width: 100%; height: 150px; object-fit: cover; background: #e2e8f0; border-bottom: 1px solid var(--border); }
        .topic-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; pointer-events: none; }
        .topic-title { font-size: 1.15rem; font-weight: 700; line-height: 1.3; color: var(--text-main); letter-spacing: -0.01em;}
        
        .topics-container.list-view, .sources-list { grid-template-columns: 1fr; gap: 0.75rem; }
        .topics-container.list-view .topic-card { flex-direction: row; align-items: center; padding: 1rem 1.5rem; gap: 1.5rem; }
        .topics-container.list-view .topic-image { display: none; }
        .topics-container.list-view .topic-content { flex-direction: row; justify-content: space-between; width: 100%; padding: 0; }
        .topics-container.list-view .topic-title { font-size: 1.05rem; min-width: 200px; }

        .source-card { background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; transition: var(--transition); cursor: pointer; gap: 1.25rem; box-shadow: var(--shadow-sm);}
        .source-card:hover { background: var(--surface); border-color: #93c5fd; box-shadow: var(--shadow-md); transform: translateY(-2px);}
        .source-cover-thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; background: #fff;}
        .source-info { flex-grow: 1; }
        .source-info h4 { font-size: 1.05rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.15rem; letter-spacing: -0.01em;}
        .source-info p { font-size: 0.85rem; color: var(--text-muted); font-weight: 500;}
        .source-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.75rem; flex-shrink: 0;}
        
        /* CATEGORY MANAGEMENT PANEL */
        .cat-management-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
        .cat-list-item { display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 0.5rem; background: var(--surface); transition: var(--transition); box-shadow: var(--shadow-sm);}
        .cat-list-item:hover { border-color: #93c5fd; box-shadow: var(--shadow-md); transform: translateY(-1px);}
        
        /* MODALS */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: flex; justify-content: center; align-items: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; padding: 1rem; }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-content { background: var(--surface); width: 100%; max-width: 700px; max-height: 90vh; border-radius: 20px; overflow-y: auto; position: relative; transform: translateY(20px) scale(0.98); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; }
        .modal-overlay.active .modal-content { transform: translateY(0) scale(1); }
        
        .modal-controls-top { position: absolute; top: 1.25rem; right: 1.25rem; display: flex; gap: 0.5rem; z-index: 10; }
        .modal-btn { background: var(--surface); border: 1px solid var(--border); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-main); box-shadow: var(--shadow-sm); transition: var(--transition); font-size: 1.1rem; }
        .modal-btn:hover { background: var(--bg); border-color: var(--primary); color: var(--primary); transform: translateY(-1px);}
        .modal-btn.danger:hover { border-color: #ef4444; color: #ef4444; background: #fef2f2; }

        .modal-header-img { width: 100%; height: 220px; object-fit: cover; background: #e2e8f0; }
        .modal-body { padding: 2.5rem; }
        .modal-title { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; line-height: 1.2; padding-right: 100px; color: var(--text-main); letter-spacing: -0.02em;}
        
        /* FORMS */
        .form-group { margin-bottom: 1.5rem; }
        label.input-label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); letter-spacing: 0.02em;}
        
        /* Modern Inputs */
        input[type="text"], input[type="url"], select, input[type="password"] { 
            width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); 
            font-family: inherit; font-size: 0.95rem; font-weight: 500; transition: var(--transition); 
            background: var(--bg); color: var(--text-main);
        }
        input:focus, select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1); background: var(--surface); }
        
        .chip-selector-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg); min-height: 60px; }
        .chip { padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid transparent; transition: var(--transition); user-select: none; display: flex; align-items: center; gap: 0.35rem; box-sizing: border-box;}
        .chip:hover { transform: translateY(-1px); }
        
        .chip.field-chip { color: white; filter: grayscale(70%) opacity(0.7); }
        .chip.field-chip.active { filter: none; box-shadow: var(--shadow-sm); }
        
        .chip.section-chip { background: var(--surface) !important; color: var(--text-main); border: 1px solid var(--border); filter: opacity(0.6);}
        .chip.section-chip.active { filter: none; box-shadow: var(--shadow-sm); }

        .chip.inactive-ghost { background: var(--surface) !important; color: var(--text-main); border: 1px solid var(--border); }
        .chip.inactive-ghost.active { background: var(--primary) !important; color: white; border-color: var(--primary); }
        
        .form-actions { display: flex; gap: 1rem; margin-top: 2.5rem; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 1.5rem;}
        .btn-cancel { background: transparent; color: var(--text-muted); font-weight: 600; border: none; cursor: pointer; padding: 0.75rem 1rem; transition: var(--transition);}
        .btn-cancel:hover { color: var(--text-main); background: var(--bg); border-radius: var(--radius-md);}
        
        .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; max-height: 200px; overflow-y: auto; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg); }

        @media (max-width: 900px) { 
            .layout { grid-template-columns: 1fr; } 
            .sidebar { display: none; position: static; max-height: none;}
            .sidebar.active { display: flex; }
            .cat-management-grid { grid-template-columns: 1fr; }
            .checkbox-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="title-area">
                <h1>Knowledge Vault</h1>
                <p>Organize, filter, and explore your intellectual pursuits</p>
            </div>
            <div class="controls-area">
                <button class="icon-btn" id="openSettingsBtn" title="Settings & Database">⚙️ DB Connection</button>
                <div class="view-controls" id="gridListControls">
                    <button class="view-btn active" id="btn-grid">Grid</button>
                    <button class="view-btn" id="btn-list">List</button>
                </div>
                <button class="btn-primary" id="mainAddTopicBtn" style="display: flex;">+ New Topic</button>
                <button class="btn-primary" id="mainAddSourceBtn" style="display: none;">+ New Source</button>
                <button class="btn-primary" id="mobileFilterToggle" style="display: none;">Filters</button>
            </div>
        </header>

        <!-- Main Navigation -->
        <div class="main-nav">
            <button class="nav-tab active" id="tab-topics">📚 Topics</button>
            <button class="nav-tab" id="tab-sources">🔖 Sources & References</button>
            <button class="nav-tab" id="tab-categories">🏷️ Fields & Sections</button>
        </div>
        
        <div class="layout">
            <aside class="sidebar active" id="sidebar">
                <!-- SIDEBAR TOPICS -->
                <div class="sidebar-section active" id="sidebar-topics">
                    <div class="panel">
                        <h2>Filter Topics</h2>
                        <div class="filter-group">
                            <h3>Main Fields</h3>
                            <div class="checkbox-list" id="fields-filter-list"></div>
                        </div>
                        <div class="filter-group" id="sections-filter-container">
                            <h3>Subsections</h3>
                            <div class="checkbox-list" id="sections-filter-list"></div>
                        </div>
                    </div>
                </div>

                <!-- SIDEBAR SOURCES -->
                <div class="sidebar-section" id="sidebar-sources">
                    <div class="panel">
                        <h2>Filter Sources</h2>
                        <div class="filter-group">
                            <h3>Reading Status</h3>
                            <div class="checkbox-list" id="source-status-filters"></div>
                        </div>
                        <div class="filter-group">
                            <h3>Type</h3>
                            <div class="checkbox-list" id="source-type-filters"></div>
                        </div>
                    </div>
                </div>

                <!-- SIDEBAR CATEGORIES -->
                <div class="sidebar-section" id="sidebar-categories">
                    <div class="panel">
                        <h2>Structure Management</h2>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.5;">Manage the database. Modifying a field or section name will <strong>automatically update all linked topics</strong>.</p>
                        <p id="statsText" style="font-size: 0.85rem; font-weight: 600; padding: 1rem; background: var(--bg); border-radius: var(--radius-md); border: 1px solid var(--border);"></p>
                    </div>
                </div>
            </aside>
            
            <main class="content-area">
                <!-- VIEW TOPICS -->
                <div class="view-section active" id="view-topics">
                    <div class="topics-container grid-view" id="topicsContainer">
                        <p id="statusText">Checking database connection...</p>
                    </div>
                </div>

                <!-- VIEW SOURCES -->
                <div class="view-section" id="view-sources">
                    <div class="sources-list" id="sourcesContainer"></div>
                </div>

                <!-- VIEW CATEGORIES -->
                <div class="view-section" id="view-categories">
                    <div class="panel" style="background: transparent; border: none; box-shadow: none; padding: 0;">
                        <div class="cat-management-grid">
                            <!-- Field Management -->
                            <div class="panel">
                                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.5rem;">
                                    <h3 style="font-size:1.1rem; font-weight:700;">Main Fields</h3>
                                    <button class="btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.85rem;" onclick="openEditFieldModal()">+ New Field</button>
                                </div>
                                <div id="adminFieldsList"></div>
                            </div>
                            
                            <!-- Section Management -->
                            <div class="panel">
                                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.5rem;">
                                    <h3 style="font-size:1.1rem; font-weight:700;">Subsections</h3>
                                    <button class="btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.85rem;" onclick="openEditSectionModal()">+ New Subsection</button>
                                </div>
                                <div id="adminSectionsList"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modals -->
    <!-- Topic Detail -->
    <div class="modal-overlay" id="topicDetailModal">
        <div class="modal-content">
            <div class="modal-controls-top">
                <button class="modal-btn" id="editTopicModeBtn" title="Edit">✏️</button>
                <button class="modal-btn danger" id="deleteTopicBtn" title="Delete">🗑️</button>
                <button class="modal-btn" id="closeTopicModalBtn">&times;</button>
            </div>
            <img src="" class="modal-header-img" id="detailTopicImg">
            <div class="modal-body">
                <h2 class="modal-title" id="detailTopicTitle">Title</h2>
                <div class="tags" id="detailTopicTags" style="margin-bottom: 1.5rem;"></div>
                
                <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 2rem;">
                    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-main);">🔖 Linked Sources</h3>
                    <div style="display: flex; gap: 0.75rem; margin-bottom: 1.5rem;">
                        <input type="text" id="searchSourceInput" list="allSourcesDatalist" placeholder="Search existing source to link...">
                        <datalist id="allSourcesDatalist"></datalist>
                        <button class="btn-secondary" id="linkExistingSourceBtn">Link</button>
                    </div>
                    <div class="sources-list" id="topicSpecificSourcesContainer" style="margin-bottom: 1.5rem;"></div>
                    <button class="btn-secondary" id="createNewSourceFromTopicBtn" style="width: 100%; justify-content: center;">+ Create New Source for this Topic</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Topic Form Modal -->
    <div class="modal-overlay" id="topicFormModal">
        <div class="modal-content" style="max-width: 600px;">
            <div class="modal-body">
                <h2 class="modal-title" id="topicFormTitle">New Topic</h2>
                <form id="topicForm">
                    <div class="form-group">
                        <label class="input-label">Title</label>
                        <input type="text" id="formTopicTitle" required>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Select Fields</label>
                        <div class="chip-selector-grid" id="fieldChipSelector"></div>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Subsections (Relevant to chosen Fields)</label>
                        <div class="chip-selector-grid" id="sectionChipSelector"></div>
                    </div>
                    
                    <!-- NEW: Primary Section Selector -->
                    <div class="form-group" id="primarySectionGroup" style="display: none;">
                        <label class="input-label">Primary Subsection (★)</label>
                        <select id="formPrimarySection">
                            <option value="">None</option>
                        </select>
                        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Highlight the main topic focus.</p>
                    </div>

                    <div class="form-group">
                        <label class="input-label">Image URL (Optional)</label>
                        <input type="url" id="formTopicImgUrl" placeholder="https://...">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="document.getElementById('topicFormModal').classList.remove('active')">Cancel</button>
                        <button type="submit" class="btn-primary" id="saveTopicBtn">Save Topic</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Source Form Modal -->
    <div class="modal-overlay" id="sourceFormModal">
        <div class="modal-content" style="max-width: 600px;">
            <div class="modal-body">
                <div class="modal-controls-top" id="sourceFormDeleteControl" style="display: none;">
                    <button type="button" class="modal-btn danger" id="deleteSourceBtn" title="Delete Source">🗑</button>
                </div>
                <h2 class="modal-title" id="sourceFormTitle">New Source</h2>
                <form id="sourceForm">
                    <div class="form-group">
                        <label class="input-label">Document / Book Title</label>
                        <input type="text" id="formSourceTitle" required>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                        <div class="form-group">
                            <label class="input-label">Author</label>
                            <input type="text" id="formSourceAuthor">
                        </div>
                        <div class="form-group">
                            <label class="input-label">Year</label>
                            <input type="text" id="formSourceYear">
                        </div>
                        <div class="form-group">
                            <label class="input-label">Type</label>
                            <select id="formSourceType" required>
                                <option value="Book">Book</option>
                                <option value="Academic Article">Academic Article</option>
                                <option value="Official Document">Official Document</option>
                                <option value="Website">Website / Online Article</option>
                                <option value="Video / Documentary">Video / Documentary</option>
                                <option value="Podcast">Podcast</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="input-label">Reading Status</label>
                            <select id="formSourceStatus">
                                <option value="To Read">To Read / In Library</option>
                                <option value="Reading">Reading</option>
                                <option value="Read">Read</option>
                                <option value="Consulted">Consulted</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Link (Generates auto-cover if valid)</label>
                        <input type="url" id="formSourceUrl" placeholder="https://...">
                    </div>
                    <div class="form-group">
                        <label class="input-label">Link to Topics</label>
                        <div class="chip-selector-grid" id="sourceTopicsSelector"></div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="document.getElementById('sourceFormModal').classList.remove('active')">Cancel</button>
                        <button type="submit" class="btn-primary" id="saveSourceBtn">Save Source</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- FIELD Edit Modal -->
    <div class="modal-overlay" id="editFieldModal">
        <div class="modal-content" style="max-width: 450px;">
            <div class="modal-body">
                <h2 class="modal-title" id="editFieldTitle">Manage Field</h2>
                <form id="editFieldForm">
                    <input type="hidden" id="editFieldOldName">
                    <div class="form-group">
                        <label class="input-label">Field Name</label>
                        <input type="text" id="editFieldName" required>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Color</label>
                        <div style="display:flex; align-items:center; gap:1.25rem; background: var(--bg); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
                            <input type="color" id="editFieldColor" style="width: 50px; height: 50px; padding: 0; cursor: pointer; border: 2px solid var(--border); border-radius:10px;">
                            <span style="font-size:0.9rem; color:var(--text-muted); font-weight: 500;">Choose a representing color</span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="document.getElementById('editFieldModal').classList.remove('active')">Cancel</button>
                        <button type="submit" class="btn-primary" id="saveFieldBtn">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SUBSECTION Edit Modal -->
    <div class="modal-overlay" id="editSectionModal">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-body">
                <h2 class="modal-title" id="editSectionTitle">Manage Subsection</h2>
                <form id="editSectionForm">
                    <input type="hidden" id="editSectionOldName">
                    <div class="form-group">
                        <label class="input-label">Subsection Name</label>
                        <input type="text" id="editSectionName" required>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Belongs to Fields:</label>
                        <div class="checkbox-grid" id="editSectionParentsGrid"></div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="document.getElementById('editSectionModal').classList.remove('active')">Cancel</button>
                        <button type="submit" class="btn-primary" id="saveSectionBtn">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Settings DB Modal (GitHub Gist) -->
    <div class="modal-overlay" id="settingsModal">
        <div class="modal-content" style="max-width: 500px; padding: 1rem;">
            <div class="modal-body">
                <h2 class="modal-title" style="font-size: 1.5rem;">Database Connection</h2>
                <form id="settingsForm">
                    <div class="form-group">
                        <label class="input-label">Gist ID</label>
                        <input type="text" id="gistId" required>
                    </div>
                    <div class="form-group">
                        <label class="input-label">Personal Access Token (PAT)</label>
                        <input type="password" id="githubPat" required>
                    </div>
                    <div class="form-actions" style="margin-top: 1.5rem; justify-content: flex-start;">
                        <button type="submit" class="btn-primary" id="saveSettingsBtn" style="width: 100%;">Save & Connect</button>
                        <button type="button" class="btn-cancel" style="width: 100%; text-align: center;" id="closeSettingsBtn">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // --- DATA STATE ---
        let topics = [];
        let sources = [];
        let metadata = { fields: [], sections: [] }; 
        
        let activeTab = 'topics';
        let currentEditingId = null; 
        let activeTopicInDetail = null;

        let formSelectedFields = new Set();
        let formSelectedSections = new Set();
        let formSelectedTopicsForSource = new Set();

        let selectedFilterFields = new Set();
        let selectedFilterSections = new Set();
        let selectedFilterSourceTypes = new Set();
        let selectedFilterSourceStatuses = new Set();

        if(window.innerWidth <= 900) { document.getElementById('mobileFilterToggle').style.display = 'block'; }
        document.getElementById('mobileFilterToggle').addEventListener('click', () => { document.getElementById('sidebar').classList.toggle('active'); });

        // --- UI UTILITIES ---
        function toggleLoading(btnId, isLoading, originalText = 'Save') {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            if (isLoading) {
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner"></span> Saving...`;
            } else {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // --- NAVIGATION TABS ---
        function switchTab(tab) {
            activeTab = tab;
            ['topics', 'sources', 'categories'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.toggle('active', tab === t);
                document.getElementById(`view-${t}`).classList.toggle('active', tab === t);
                document.getElementById(`sidebar-${t}`).classList.toggle('active', tab === t);
            });
            document.getElementById('gridListControls').style.display = tab === 'topics' ? 'flex' : 'none';
            document.getElementById('mainAddTopicBtn').style.display = tab === 'topics' ? 'flex' : 'none';
            document.getElementById('mainAddSourceBtn').style.display = tab === 'sources' ? 'flex' : 'none';
        }
        document.getElementById('tab-topics').addEventListener('click', () => switchTab('topics'));
        document.getElementById('tab-sources').addEventListener('click', () => switchTab('sources'));
        document.getElementById('tab-categories').addEventListener('click', () => switchTab('categories'));

        // --- COLOR CODING MINIMALISTA ---
        function generateRandomColor() {
            const colors = ['#e11d48', '#d97706', '#059669', '#0284c7', '#4f46e5', '#7c3aed', '#c026d3', '#0891b2', '#ea580c', '#65a30d'];
            return colors[Math.floor(Math.random() * colors.length)];
        }

        function getFieldColor(fieldName) {
            const f = metadata.fields.find(x => x && x.name === fieldName);
            return f ? f.color : '#94a3b8'; // Fallback
        }

        // Sistema a bordi segmentati per le sottosezioni (Multi-parent)
        function getSectionSegmentedBorder(sectionName) {
            const sec = metadata.sections.find(s => s && s.name === sectionName);
            const parents = sec && sec.parents ? sec.parents : [];
            
            if (parents.length === 0) return 'border: 2.5px solid #cbd5e1; background: var(--surface); color: var(--text-main);';
            
            if (parents.length === 1) {
                const color = getFieldColor(parents[0]);
                return `border: 2.5px solid ${color}; background: var(--surface); color: ${color};`;
            }

            const step = 100 / parents.length;
            let gradientParts = parents.map((p, i) => `${getFieldColor(p)} ${i * step}% ${(i + 1) * step}%`).join(', ');
            
            return `
                border: 2.5px solid transparent;
                background: linear-gradient(var(--surface), var(--surface)) padding-box, 
                            linear-gradient(to right, ${gradientParts}) border-box;
                color: var(--text-main);
            `;
        }

        function getFallbackTopicCover(topic) {
            let color = '#334155';
            if (topic.fields && topic.fields.length > 0) color = getFieldColor(topic.fields[0]);
            const hex = color.replace('#', '');
            return `https://ui-avatars.com/api/?name=${encodeURIComponent(topic.title)}&background=${hex}&color=fff&size=800&font-size=0.15&length=3`;
        }

        function getSourceCover(source) {
            if (source.url && source.url.startsWith('http')) {
                try {
                    const hostname = new URL(source.url).hostname;
                    return `https://www.google.com/s2/favicons?domain=${hostname}&sz=128`;
                } catch(e) {}
            }
            return `https://ui-avatars.com/api/?name=${encodeURIComponent(source.title)}&background=e2e8f0&color=475569&size=128&font-size=0.3`;
        }

        function getFallbackImageUrl(title) {
            return `https://ui-avatars.com/api/?name=${encodeURIComponent(title || 'Source')}&background=e2e8f0&color=475569&size=128&font-size=0.3`;
        }

        function ensureMetadataIntegrity() {
            let changed = false;
            
            if (!metadata) metadata = { fields: [], sections: [] };
            if (!Array.isArray(metadata.fields)) metadata.fields = [];
            if (!Array.isArray(metadata.sections)) metadata.sections = [];
            
            metadata.fields = metadata.fields.map(f => {
                if (typeof f === 'string') { changed = true; return { name: f, color: generateRandomColor() }; }
                return f;
            }).filter(Boolean);

            metadata.sections = metadata.sections.map(s => {
                if (typeof s === 'string') { changed = true; return { name: s, parents: [] }; }
                return s;
            }).filter(Boolean);

            const existingFields = new Set(metadata.fields.filter(f => f && f.name).map(f => f.name));
            topics.forEach(t => {
                (t.fields || []).forEach(f => {
                    if (!existingFields.has(f)) { metadata.fields.push({ name: f, color: generateRandomColor() }); existingFields.add(f); changed = true; }
                });
            });
            const secMap = new Map(metadata.sections.filter(s => s && s.name).map(s => [s.name, new Set(s.parents || [])]));
            topics.forEach(t => {
                (t.sections || []).forEach(s => {
                    if (!secMap.has(s)) secMap.set(s, new Set(t.fields || []));
                    else (t.fields || []).forEach(f => secMap.get(s).add(f));
                    changed = true;
                });
            });
            metadata.sections = Array.from(secMap.entries()).map(([name, parents]) => ({ name, parents: Array.from(parents) }));

            sources.forEach(s => {
                const typeMap = { 'Libro': 'Book', 'Articolo Accademico': 'Academic Article', 'Documento Ufficiale': 'Official Document', 'Sito Web': 'Website', 'Sito Web / Articolo Online': 'Website', 'Video/Documentario': 'Video / Documentary', 'Altro': 'Other' };
                const statusMap = { 'Da leggere': 'To Read', 'In lettura': 'Reading', 'Letto': 'Read', 'Consultato': 'Consulted', 'Sospeso': 'On Hold' };
                
                if (typeMap[s.type]) { s.type = typeMap[s.type]; changed = true; }
                if (statusMap[s.status]) { s.status = statusMap[s.status]; changed = true; }
            });

            return changed;
        }

        // --- API GITHUB ---
        const settingsModal = document.getElementById('settingsModal');
        function getCredentials() { return { gistId: localStorage.getItem('kv_gist_id'), pat: localStorage.getItem('kv_github_pat') }; }

        document.getElementById('openSettingsBtn').addEventListener('click', () => {
            const c = getCredentials();
            if(c.gistId) document.getElementById('gistId').value = c.gistId;
            if(c.pat) document.getElementById('githubPat').value = c.pat;
            settingsModal.classList.add('active');
        });
        document.getElementById('closeSettingsBtn').addEventListener('click', () => settingsModal.classList.remove('active'));
        
        document.getElementById('settingsForm').addEventListener('submit', (e) => {
            e.preventDefault();
            let rawId = document.getElementById('gistId').value.trim();
            if (rawId.includes('/')) rawId = rawId.split('/').pop();
            localStorage.setItem('kv_gist_id', rawId.substring(0,32));
            localStorage.setItem('kv_github_pat', document.getElementById('githubPat').value.trim());
            settingsModal.classList.remove('active');
            loadData();
        });

        async function loadData() {
            const { gistId, pat } = getCredentials();
            if (!gistId || !pat) { settingsModal.classList.add('active'); return; }
            try {
                document.getElementById('statusText').innerHTML = '<span class="spinner" style="border-top-color: var(--primary);"></span> Loading data...';
                const response = await fetch(`https://api.github.com/gists/${gistId}`, { headers: { 'Authorization': `token ${pat}` } });
                if (!response.ok) throw new Error('API Error. Check Token and Gist ID.');
                
                const gist = await response.json();
                topics = gist.files['data.json'] ? JSON.parse(gist.files['data.json'].content || '[]') : [];
                sources = gist.files['sources.json'] ? JSON.parse(gist.files['sources.json'].content || '[]') : [];
                metadata = gist.files['metadata.json'] ? JSON.parse(gist.files['metadata.json'].content || '{"fields":[], "sections":[]}') : {fields:[], sections:[]};
                
                let dataModified = ensureMetadataIntegrity();
                sources.forEach(s => {
                    if (s.topicId && !s.topicIds) { s.topicIds = [s.topicId]; delete s.topicId; dataModified = true;}
                    if (!s.topicIds) { s.topicIds = []; dataModified = true; }
                    if (!s.status) { s.status = 'To Read'; dataModified = true; }
                });

                if (dataModified) saveData(false);
                updateUI();
            } catch (err) { document.getElementById('topicsContainer').innerHTML = `<p style="color:#ef4444; padding:1rem; font-weight: 500;">Error: ${err.message}</p>`; }
        }

        async function saveData(refresh = true, btnId = null, btnText = 'Save') {
            const { gistId, pat } = getCredentials();
            if (!gistId || !pat) return;
            
            if (btnId) toggleLoading(btnId, true, btnText);
            
            try {
                await fetch(`https://api.github.com/gists/${gistId}`, {
                    method: 'PATCH',
                    headers: { 'Authorization': `token ${pat}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ files: { 
                        'data.json': { content: JSON.stringify(topics, null, 2) }, 
                        'sources.json': { content: JSON.stringify(sources, null, 2) },
                        'metadata.json': { content: JSON.stringify(metadata, null, 2) } 
                    }})
                });
            } catch (error) {
                console.error("Failed to save data", error);
                alert("Errore di connessione durante il salvataggio.");
            } finally {
                if (btnId) toggleLoading(btnId, false, btnText);
                if (refresh) updateUI();
            }
        }

        function updateUI() {
            renderTopicFilters();
            renderSourceFilters();
            renderTopics();
            renderSources();
            renderCategoryManagement();
            
            document.getElementById('statsText').innerHTML = `
                📚 Topics: <span style="color:var(--text-main); font-weight:700;">${topics.length}</span> &nbsp;&nbsp;|&nbsp;&nbsp; 
                🔖 Sources: <span style="color:var(--text-main); font-weight:700;">${sources.length}</span> &nbsp;&nbsp;|&nbsp;&nbsp; 
                🗂️ Fields: <span style="color:var(--text-main); font-weight:700;">${metadata.fields.length}</span> &nbsp;&nbsp;|&nbsp;&nbsp; 
                📑 Subsections: <span style="color:var(--text-main); font-weight:700;">${metadata.sections.length}</span>
            `;
            document.getElementById('allSourcesDatalist').innerHTML = sources.map(s => `<option value="${s.title}" data-id="${s.id}">`).join('');
        }

        // --- CATEGORIES SYSTEM (Cascading Edits & Modals) ---
        function renderCategoryManagement() {
            const fCont = document.getElementById('adminFieldsList'); fCont.innerHTML = '';
            metadata.fields.filter(f => f && f.name).sort((a,b)=>a.name.localeCompare(b.name)).forEach(f => {
                const item = document.createElement('div'); item.className = 'cat-list-item';
                item.innerHTML = `
                    <div style="display:flex; align-items:center; gap:1rem;">
                        <span style="width:18px; height:18px; border-radius:6px; background:${f.color}; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);"></span>
                        <strong style="font-size:1rem; color: var(--text-main);">${f.name}</strong>
                    </div>
                    <div style="display:flex; gap:0.5rem;">
                        <button class="icon-btn" style="padding:0.35rem 0.6rem;" onclick="openEditFieldModal('${f.name}')">✏️</button>
                        <button class="icon-btn danger" style="padding:0.35rem 0.6rem;" onclick="deleteField('${f.name}')">🗑️</button>
                    </div>
                `;
                fCont.appendChild(item);
            });

            const sCont = document.getElementById('adminSectionsList'); sCont.innerHTML = '';
            metadata.sections.filter(s => s && s.name).sort((a,b)=>a.name.localeCompare(b.name)).forEach(s => {
                const pText = (s.parents && s.parents.length > 0) ? s.parents.join(', ') : 'No linked field';
                const pColor = (s.parents && s.parents.length > 0) ? getFieldColor(s.parents[0]) : 'var(--text-main)';
                const item = document.createElement('div'); item.className = 'cat-list-item';
                item.innerHTML = `
                    <div>
                        <strong style="display:block; font-size:1rem; color:${pColor};">${s.name}</strong>
                        <span style="font-size:0.8rem; color:var(--text-muted); font-weight: 500;">In: ${pText}</span>
                    </div>
                    <div style="display:flex; gap:0.5rem;">
                        <button class="icon-btn" style="padding:0.35rem 0.6rem;" onclick="openEditSectionModal('${s.name}')">✏️</button>
                        <button class="icon-btn danger" style="padding:0.35rem 0.6rem;" onclick="deleteSection('${s.name}')">🗑️</button>
                    </div>
                `;
                sCont.appendChild(item);
            });
        }

        // Modal Edit FIELD
        const editFieldModal = document.getElementById('editFieldModal');
        window.openEditFieldModal = function(name = null) {
            document.getElementById('editFieldForm').reset();
            if (name) {
                const f = metadata.fields.find(x => x.name === name);
                document.getElementById('editFieldTitle').textContent = 'Edit Field';
                document.getElementById('editFieldOldName').value = f.name;
                document.getElementById('editFieldName').value = f.name;
                document.getElementById('editFieldColor').value = f.color;
            } else {
                document.getElementById('editFieldTitle').textContent = 'New Field';
                document.getElementById('editFieldOldName').value = '';
                document.getElementById('editFieldColor').value = generateRandomColor();
            }
            editFieldModal.classList.add('active');
        };

        document.getElementById('editFieldForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const oldName = document.getElementById('editFieldOldName').value;
            const newName = document.getElementById('editFieldName').value.trim();
            const newColor = document.getElementById('editFieldColor').value;
            
            if (oldName) {
                const f = metadata.fields.find(x => x.name === oldName);
                if (f) { f.name = newName; f.color = newColor; }
                if (oldName !== newName) {
                    metadata.sections.forEach(s => { s.parents = (s.parents || []).map(p => p === oldName ? newName : p); });
                    topics.forEach(t => { if(t.fields) t.fields = t.fields.map(field => field === oldName ? newName : field); });
                }
            } else {
                if (metadata.fields.some(f => f && f.name.toLowerCase() === newName.toLowerCase())) { alert("Field already exists!"); return; }
                metadata.fields.push({name: newName, color: newColor});
            }
            await saveData(true, 'saveFieldBtn', 'Save Changes'); 
            editFieldModal.classList.remove('active');
        });

        window.deleteField = async function(name) {
            if(confirm(`Delete field "${name}"? It will be removed from topics and subsections.`)){
                metadata.fields = metadata.fields.filter(x => x.name !== name);
                metadata.sections.forEach(s => { s.parents = (s.parents || []).filter(p => p !== name); });
                topics.forEach(t => { if(t.fields) t.fields = t.fields.filter(f => f !== name); });
                await saveData(true); 
            }
        };

        // Modal Edit SUBSECTION
        const editSectionModal = document.getElementById('editSectionModal');
        window.openEditSectionModal = function(name = null) {
            document.getElementById('editSectionForm').reset();
            const grid = document.getElementById('editSectionParentsGrid'); grid.innerHTML = '';
            let parents = [];
            
            if (name) {
                const s = metadata.sections.find(x => x.name === name);
                document.getElementById('editSectionTitle').textContent = 'Edit Subsection';
                document.getElementById('editSectionOldName').value = s.name;
                document.getElementById('editSectionName').value = s.name;
                parents = s.parents || [];
            } else {
                document.getElementById('editSectionTitle').textContent = 'New Subsection';
                document.getElementById('editSectionOldName').value = '';
            }

            metadata.fields.filter(f => f && f.name).forEach(f => {
                const checked = parents.includes(f.name) ? 'checked' : '';
                grid.innerHTML += `<label class="checkbox-label"><input type="checkbox" value="${f.name}" ${checked}> ${f.name}</label>`;
            });
            editSectionModal.classList.add('active');
        };

        document.getElementById('editSectionForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const oldName = document.getElementById('editSectionOldName').value;
            const newName = document.getElementById('editSectionName').value.trim();
            const newParents = Array.from(document.querySelectorAll('#editSectionParentsGrid input:checked')).map(cb => cb.value);
            
            if (oldName) {
                const s = metadata.sections.find(x => x.name === oldName);
                if (s) { s.name = newName; s.parents = newParents; }
                if (oldName !== newName) {
                    topics.forEach(t => { if(t.sections) t.sections = t.sections.map(sec => sec === oldName ? newName : sec); });
                    // Also check if primarySection needs updating
                    topics.forEach(t => { if(t.primarySection === oldName) t.primarySection = newName; });
                }
            } else {
                if (metadata.sections.some(s => s && s.name.toLowerCase() === newName.toLowerCase())) { alert("Subsection already exists!"); return; }
                metadata.sections.push({name: newName, parents: newParents});
            }
            await saveData(true, 'saveSectionBtn', 'Save Changes'); 
            editSectionModal.classList.remove('active');
        });

        window.deleteSection = async function(name) {
            if(confirm(`Delete subsection "${name}"? It will be removed from topics.`)){
                metadata.sections = metadata.sections.filter(x => x.name !== name);
                topics.forEach(t => { 
                    if(t.sections) t.sections = t.sections.filter(s => s !== name); 
                    if(t.primarySection === name) t.primarySection = null;
                });
                await saveData(true);
            }
        };

        // --- TAG SYSTEM FOR FORMS (Chip Selectors) ---
        function updatePrimarySectionDropdown(currentPrimary = null) {
            const primaryGroup = document.getElementById('primarySectionGroup');
            const primarySelect = document.getElementById('formPrimarySection');
            
            if (formSelectedSections.size > 0) {
                primaryGroup.style.display = 'block';
                const optionsHTML = `<option value="">None</option>` + 
                                    Array.from(formSelectedSections).map(s => `<option value="${s}">${s}</option>`).join('');
                primarySelect.innerHTML = optionsHTML;
                
                if (currentPrimary && formSelectedSections.has(currentPrimary)) {
                    primarySelect.value = currentPrimary;
                }
            } else {
                primaryGroup.style.display = 'none';
                primarySelect.innerHTML = '<option value="">None</option>';
            }
        }

        function renderFormChips() {
            const fieldCont = document.getElementById('fieldChipSelector'); fieldCont.innerHTML = '';
            metadata.fields.filter(f => f && f.name).sort((a,b)=>a.name.localeCompare(b.name)).forEach(f => {
                const c = document.createElement('div');
                c.className = `chip field-chip ${formSelectedFields.has(f.name) ? 'active' : ''}`;
                c.style.background = f.color;
                c.textContent = f.name;
                c.onclick = () => { 
                    formSelectedFields.has(f.name) ? formSelectedFields.delete(f.name) : formSelectedFields.add(f.name); 
                    const validSecs = metadata.sections.filter(s => (s.parents||[]).some(p => formSelectedFields.has(p))).map(s=>s.name);
                    for (let item of formSelectedSections) { if(!validSecs.includes(item)) formSelectedSections.delete(item); }
                    
                    const currentPrimary = document.getElementById('formPrimarySection').value;
                    renderFormChips(); 
                    updatePrimarySectionDropdown(currentPrimary);
                };
                fieldCont.appendChild(c);
            });

            const secCont = document.getElementById('sectionChipSelector'); secCont.innerHTML = '';
            if (formSelectedFields.size === 0) { secCont.innerHTML = '<span style="font-size:0.85rem; color:var(--text-muted); padding:0.5rem; font-weight: 500;">Select a field above first.</span>'; return; }
            
            const relevantSections = metadata.sections.filter(s => (s.parents||[]).some(p => formSelectedFields.has(p)));
            relevantSections.sort((a,b)=>a.name.localeCompare(b.name)).forEach(s => {
                const c = document.createElement('div');
                c.className = `chip section-chip ${formSelectedSections.has(s.name) ? 'active' : ''}`;
                c.style.cssText = formSelectedSections.has(s.name) ? getSectionSegmentedBorder(s.name) : 'border: 1.5px solid var(--border);';
                c.textContent = s.name;
                c.onclick = () => { 
                    formSelectedSections.has(s.name) ? formSelectedSections.delete(s.name) : formSelectedSections.add(s.name); 
                    const currentPrimary = document.getElementById('formPrimarySection').value;
                    renderFormChips(); 
                    updatePrimarySectionDropdown(currentPrimary);
                };
                secCont.appendChild(c);
            });
        }

        // --- GESTIONE FORM MODALS ---
        // Topics
        const topicFormModal = document.getElementById('topicFormModal');
        document.getElementById('mainAddTopicBtn').addEventListener('click', () => {
            document.getElementById('topicForm').reset();
            currentEditingId = null; formSelectedFields.clear(); formSelectedSections.clear();
            document.getElementById('topicFormTitle').textContent = 'New Topic';
            renderFormChips(); updatePrimarySectionDropdown();
            topicFormModal.classList.add('active');
        });

        document.getElementById('topicForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(formSelectedFields.size === 0) { alert("Select at least one field."); return; }
            const tData = {
                id: currentEditingId || Date.now().toString(),
                title: document.getElementById('formTopicTitle').value.trim(),
                fields: Array.from(formSelectedFields),
                sections: Array.from(formSelectedSections),
                primarySection: document.getElementById('formPrimarySection').value || null,
                image: document.getElementById('formTopicImgUrl').value.trim()
            };
            topics = currentEditingId ? topics.map(t => t.id === currentEditingId ? tData : t) : [tData, ...topics];
            await saveData(true, 'saveTopicBtn', 'Save Topic');
            topicFormModal.classList.remove('active');
        });

        // Sources
        const sourceFormModal = document.getElementById('sourceFormModal');
        function renderSourceTopicsSelector() {
            const cont = document.getElementById('sourceTopicsSelector'); cont.innerHTML = '';
            topics.sort((a,b)=>a.title.localeCompare(b.title)).forEach(t => {
                const c = document.createElement('div');
                c.className = `chip inactive-ghost ${formSelectedTopicsForSource.has(t.id) ? 'active' : ''}`;
                c.textContent = t.title;
                c.onclick = () => { formSelectedTopicsForSource.has(t.id) ? formSelectedTopicsForSource.delete(t.id) : formSelectedTopicsForSource.add(t.id); renderSourceTopicsSelector(); };
                cont.appendChild(c);
            });
        }
        
        document.getElementById('mainAddSourceBtn').addEventListener('click', () => openSourceForm());
        
        function openSourceForm(preselectedTopicId = null) {
            document.getElementById('sourceForm').reset();
            currentEditingId = null; formSelectedTopicsForSource.clear();
            if(preselectedTopicId) formSelectedTopicsForSource.add(preselectedTopicId);
            document.getElementById('sourceFormTitle').textContent = 'New Source';
            document.getElementById('sourceFormDeleteControl').style.display = 'none';
            renderSourceTopicsSelector(); sourceFormModal.classList.add('active');
        }

        document.getElementById('sourceForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const sData = {
                id: currentEditingId || Date.now().toString(),
                title: document.getElementById('formSourceTitle').value.trim(),
                author: document.getElementById('formSourceAuthor').value.trim(),
                type: document.getElementById('formSourceType').value,
                status: document.getElementById('formSourceStatus').value,
                year: document.getElementById('formSourceYear').value.trim(),
                url: document.getElementById('formSourceUrl').value.trim(),
                topicIds: Array.from(formSelectedTopicsForSource)
            };
            sources = currentEditingId ? sources.map(s => s.id === currentEditingId ? sData : s) : [sData, ...sources];
            await saveData(true, 'saveSourceBtn', 'Save Source');
            sourceFormModal.classList.remove('active');
            if (activeTopicInDetail) renderDetailTopicSources(activeTopicInDetail.id);
        });

        // --- DETTAGLIO ARGOMENTO & LINKING ---
        const topicDetailModal = document.getElementById('topicDetailModal');
        function openTopicDetail(topic) {
            activeTopicInDetail = topic;
            document.getElementById('detailTopicTitle').textContent = topic.title;
            document.getElementById('detailTopicImg').src = topic.image || getFallbackTopicCover(topic);
            
            // Render Tag nel Modale (Primary Section per prima, con stella)
            const fHtml = (topic.fields||[]).map(f => `<span class="tag tag-field" style="background:${getFieldColor(f)}">${f}</span>`).join('');
            
            const sortedSections = [...(topic.sections || [])].sort((a, b) => {
                if (a === topic.primarySection) return -1;
                if (b === topic.primarySection) return 1;
                return 0;
            });

            const sHtml = sortedSections.map(s => {
                const isPrimary = s === topic.primarySection;
                const starHTML = isPrimary ? '<span class="tag-primary-star">★</span>' : '';
                return `<span class="tag tag-section" style="${getSectionSegmentedBorder(s)}">${starHTML}${s}</span>`;
            }).join('');
            
            document.getElementById('detailTopicTags').innerHTML = fHtml + sHtml;
            
            document.getElementById('searchSourceInput').value = '';
            renderDetailTopicSources(topic.id);
            topicDetailModal.classList.add('active');
        }
        document.getElementById('closeTopicModalBtn').addEventListener('click', () => { topicDetailModal.classList.remove('active'); activeTopicInDetail = null; });

        function renderDetailTopicSources(topicId) {
            const cont = document.getElementById('topicSpecificSourcesContainer');
            const specificSources = sources.filter(s => s.topicIds && s.topicIds.includes(topicId));
            if (specificSources.length === 0) { cont.innerHTML = '<p style="color:var(--text-muted); font-size:0.9rem; font-weight:500;">No linked sources.</p>'; return; }
            cont.innerHTML = specificSources.map(s => {
                const author = s.author ? `by ${s.author}` : ''; 
                const link = s.url ? `<a href="${s.url}" target="_blank" style="color:var(--primary); font-size:0.875rem; font-weight:600;" onclick="event.stopPropagation();">Open</a>` : '';
                return `
                <div class="source-card" style="padding: 1rem; border-radius: 12px;">
                    <img src="${getSourceCover(s)}" class="source-cover-thumb" style="width: 45px; height: 45px;" onerror="this.src=getFallbackImageUrl('${s.title.replace(/'/g, "\\'")}')">
                    <div class="source-info">
                        <h4 style="font-size:0.95rem; margin-bottom:0.15rem;">${s.title}</h4>
                        <p style="font-size:0.8rem;">${author}</p>
                    </div>
                    <div class="source-meta">
                        ${link}
                        <button class="icon-btn" style="padding:0.25rem 0.5rem; font-size:0.8rem;" onclick="editSource('${s.id}'); event.stopPropagation();">✏️</button>
                    </div>
                </div>`;
            }).join('');
        }

        document.getElementById('linkExistingSourceBtn').addEventListener('click', async () => {
            const inputVal = document.getElementById('searchSourceInput').value;
            const option = document.querySelector(`#allSourcesDatalist option[value="${inputVal}"]`);
            if (option && activeTopicInDetail) {
                const source = sources.find(s => s.id === option.getAttribute('data-id'));
                if (source && !source.topicIds.includes(activeTopicInDetail.id)) {
                    source.topicIds.push(activeTopicInDetail.id); 
                    
                    const btn = document.getElementById('linkExistingSourceBtn');
                    btn.disabled = true; btn.innerHTML = '...';
                    await saveData(false);
                    btn.disabled = false; btn.innerHTML = 'Link';
                    
                    document.getElementById('searchSourceInput').value = ''; 
                    renderDetailTopicSources(activeTopicInDetail.id);
                }
            }
        });

        document.getElementById('createNewSourceFromTopicBtn').addEventListener('click', () => { if(activeTopicInDetail) openSourceForm(activeTopicInDetail.id); });

        // Edit & Delete Topic
        document.getElementById('editTopicModeBtn').addEventListener('click', () => {
            if(!activeTopicInDetail) return; const t = activeTopicInDetail;
            topicDetailModal.classList.remove('active');
            currentEditingId = t.id;
            document.getElementById('formTopicTitle').value = t.title;
            document.getElementById('formTopicImgUrl').value = t.image || '';
            formSelectedFields = new Set(t.fields || []); formSelectedSections = new Set(t.sections || []);
            document.getElementById('topicFormTitle').textContent = 'Edit Topic';
            
            renderFormChips(); 
            updatePrimarySectionDropdown(t.primarySection);
            
            topicFormModal.classList.add('active');
        });

        document.getElementById('deleteTopicBtn').addEventListener('click', async () => {
            if(activeTopicInDetail && confirm("Delete this topic? (Sources will remain but be unlinked)")) {
                const tid = activeTopicInDetail.id; topics = topics.filter(t => t.id !== tid);
                sources.forEach(s => { if(s.topicIds) s.topicIds = s.topicIds.filter(id => id !== tid); });
                await saveData(true); topicDetailModal.classList.remove('active'); activeTopicInDetail = null;
            }
        });

        // Edit & Delete Source
        window.editSource = function(id) {
            const s = sources.find(x => x.id === id); if (!s) return;
            currentEditingId = id;
            document.getElementById('formSourceTitle').value = s.title;
            document.getElementById('formSourceAuthor').value = s.author || '';
            document.getElementById('formSourceType').value = s.type;
            document.getElementById('formSourceStatus').value = s.status || 'To Read';
            document.getElementById('formSourceYear').value = s.year || '';
            document.getElementById('formSourceUrl').value = s.url || '';
            formSelectedTopicsForSource = new Set(s.topicIds || []);
            
            document.getElementById('sourceFormTitle').textContent = 'Edit Source';
            document.getElementById('sourceFormDeleteControl').style.display = 'block';
            renderSourceTopicsSelector(); sourceFormModal.classList.add('active');
        };

        document.getElementById('deleteSourceBtn').addEventListener('click', async () => {
            if(currentEditingId && confirm("Permanently delete this source?")) {
                sources = sources.filter(s => s.id !== currentEditingId);
                await saveData(true); sourceFormModal.classList.remove('active');
                if (activeTopicInDetail) renderDetailTopicSources(activeTopicInDetail.id);
            }
        });

        // --- RENDER VISUALE (Main Views) ---
        function renderTopicFilters() {
            const cont = document.getElementById('fields-filter-list'); cont.innerHTML = '';
            metadata.fields.filter(f => f && f.name).sort((a,b)=>a.name.localeCompare(b.name)).forEach(f => {
                const lbl = document.createElement('label'); lbl.className = 'checkbox-label';
                lbl.innerHTML = `<input type="checkbox" value="${f.name}"> <span style="width:14px; height:14px; border-radius:4px; background:${f.color};"></span>${f.name}`;
                lbl.querySelector('input').addEventListener('change', (e) => { e.target.checked ? selectedFilterFields.add(f.name) : selectedFilterFields.delete(f.name); if(selectedFilterFields.size===0) selectedFilterSections.clear(); renderTopicSectionFilters(); renderTopics(); });
                cont.appendChild(lbl);
            });
        }
        
        function renderTopicSectionFilters() {
            const sList = document.getElementById('sections-filter-list'); const sCont = document.getElementById('sections-filter-container'); sList.innerHTML = '';
            if (selectedFilterFields.size === 0) { sCont.classList.remove('active'); return; }
            sCont.classList.add('active');
            const relevant = metadata.sections.filter(s => (s.parents||[]).some(p => selectedFilterFields.has(p)));
            relevant.sort((a,b)=>a.name.localeCompare(b.name)).forEach(sec => {
                const lbl = document.createElement('label'); lbl.className = 'checkbox-label';
                lbl.innerHTML = `<input type="checkbox" value="${sec.name}" ${selectedFilterSections.has(sec.name)?'checked':''}> ${sec.name}`;
                lbl.querySelector('input').addEventListener('change', (e) => { e.target.checked ? selectedFilterSections.add(sec.name) : selectedFilterSections.delete(sec.name); renderTopics(); });
                sList.appendChild(lbl);
            });
        }

        function renderTopics() {
            const cont = document.getElementById('topicsContainer'); cont.innerHTML = '';
            const filtered = topics.filter(t => {
                const mf = selectedFilterFields.size === 0 || (t.fields || []).some(f => selectedFilterFields.has(f));
                const ms = selectedFilterSections.size === 0 || (t.sections || []).some(s => selectedFilterSections.has(s));
                return selectedFilterFields.size > 0 && selectedFilterSections.size > 0 ? mf && ms : mf; 
            });
            if (filtered.length === 0) { cont.innerHTML = '<p style="color: var(--text-muted); font-weight: 500;">No topics found.</p>'; return; }
            filtered.forEach(t => {
                const card = document.createElement('div'); card.className = 'topic-card';
                const fTags = (t.fields||[]).map(f=>`<span class="tag tag-field" style="background:${getFieldColor(f)}">${f}</span>`).join('');
                
                // Sort sections to show primary first in the card view as well
                const sortedSections = [...(t.sections || [])].sort((a, b) => {
                    if (a === t.primarySection) return -1;
                    if (b === t.primarySection) return 1;
                    return 0;
                });
                const sTags = sortedSections.map(s => {
                    const star = (s === t.primarySection) ? '<span class="tag-primary-star">★</span>' : '';
                    return `<span class="tag tag-section" style="${getSectionSegmentedBorder(s)}">${star}${s}</span>`;
                }).join('');
                
                card.innerHTML = `<img src="${t.image || getFallbackTopicCover(t)}" class="topic-image"><div class="topic-content"><h3 class="topic-title">${t.title}</h3><div class="tags">${fTags}${sTags}</div></div>`;
                card.addEventListener('click', () => openTopicDetail(t));
                cont.appendChild(card);
            });
        }

        function renderSourceFilters() {
            const types = new Set(); const statuses = new Set();
            sources.forEach(s => { types.add(s.type); statuses.add(s.status || 'To Read'); });
            const tList = document.getElementById('source-type-filters'); tList.innerHTML = '';
            Array.from(types).sort().forEach(type => {
                const l = document.createElement('label'); l.className = 'checkbox-label'; l.innerHTML = `<input type="checkbox" value="${type}"> ${type}`;
                l.querySelector('input').addEventListener('change', (e) => { e.target.checked ? selectedFilterSourceTypes.add(type) : selectedFilterSourceTypes.delete(type); renderSources(); });
                tList.appendChild(l);
            });
            const stList = document.getElementById('source-status-filters'); stList.innerHTML = '';
            Array.from(statuses).sort().forEach(st => {
                const l = document.createElement('label'); l.className = 'checkbox-label'; l.innerHTML = `<input type="checkbox" value="${st}"> ${st}`;
                l.querySelector('input').addEventListener('change', (e) => { e.target.checked ? selectedFilterSourceStatuses.add(st) : selectedFilterSourceStatuses.delete(st); renderSources(); });
                stList.appendChild(l);
            });
        }

        function renderSources() {
            const cont = document.getElementById('sourcesContainer'); cont.innerHTML = '';
            const filtered = sources.filter(s => (selectedFilterSourceTypes.size === 0 || selectedFilterSourceTypes.has(s.type)) && (selectedFilterSourceStatuses.size === 0 || selectedFilterSourceStatuses.has(s.status || 'To Read')));
            if (filtered.length === 0) { cont.innerHTML = '<p style="color: var(--text-muted); font-weight: 500;">No sources found.</p>'; return; }
            filtered.forEach(s => {
                let topicsTags = (s.topicIds || []).map(tid => { const t = topics.find(x => x.id === tid); return t ? `<span class="tag tag-source-link">📚 ${t.title}</span>` : ''; }).join('');
                const card = document.createElement('div'); card.className = 'source-card';
                card.innerHTML = `
                    <img src="${getSourceCover(s)}" class="source-cover-thumb" onerror="this.src=getFallbackImageUrl('${s.title.replace(/'/g, "\\'")}')">
                    <div class="source-info">
                        <h4>${s.title}</h4>
                        <p>${s.author ? `by ${s.author}`:''} ${s.year ? `(${s.year})`:''}</p>
                        <div class="tags"><span class="tag tag-field" style="background:var(--text-muted); color:white; border:none;">${s.type}</span><span class="tag tag-status">${s.status||'To Read'}</span>${topicsTags}</div>
                    </div>
                    <div class="source-meta">
                        ${s.url ? `<a href="${s.url}" target="_blank" style="color:var(--primary); font-size:0.85rem; font-weight: 600;" onclick="event.stopPropagation();">Open Link</a>` : ''}
                        <button class="icon-btn" style="padding:0.35rem 0.6rem; font-size:0.8rem;" onclick="editSource('${s.id}'); event.stopPropagation();">✏️ Edit</button>
                    </div>`;
                cont.appendChild(card);
            });
        }

        // View Toggles (Grid/List)
        document.getElementById('btn-grid').addEventListener('click', (e) => { e.target.classList.add('active'); document.getElementById('btn-list').classList.remove('active'); document.getElementById('topicsContainer').className = 'topics-container grid-view'; });
        document.getElementById('btn-list').addEventListener('click', (e) => { e.target.classList.add('active'); document.getElementById('btn-grid').classList.remove('active'); document.getElementById('topicsContainer').className = 'topics-container list-view'; });

        loadData();
    </script>
</body>
</html>